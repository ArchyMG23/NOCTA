      "title": "UserPublicProfile",
      "description": "Non-sensitive user profile and workspace state",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "firstName": { "type": "string", "maxLength": 80 },
        "lastName": { "type": "string", "maxLength": 80 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "preferredLang": { "type": "string", "enum": ["fr", "en"] },
        "coupleId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "moderator", "content_manager", "admin", "super_admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "deactivated"] },
        "ageConfirmed": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
