      "description": "Platform configuration and feature activation toggles"
    },
    "/media_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/MediaCategory" },
      "description": "Super-admin managed categories for NOCTA photography"
    },
    "/media_assets/{mediaId}": {
