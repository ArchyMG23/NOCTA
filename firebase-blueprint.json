  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public/workspace user profiles without sensitive PII"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII, consent ledger, boundaries, and privacy settings"
    },
    "/users/{userId}/ledger/{activityId}": {
      "schema": { "$ref": "#/entities/IndividualLedgerItem" },
      "description": "Owner-only individual activity history and favorites"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRoleRecord" },
