    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Catalog activities with stable IDs and publication statuses"
    },
    "/imports/{importId}": {
      "schema": { "$ref": "#/entities/DocumentImport" },
      "description": "Deterministic PDF/DOCX import job records"
    },
    "/imports/{importId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/ImportExtractedItem" },
      "description": "Extracted items awaiting admin classification and duplicate verification"
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
